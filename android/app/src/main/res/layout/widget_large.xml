<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_large_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_b"
    android:orientation="vertical"
    android:paddingStart="13dp"
    android:paddingTop="11dp"
    android:paddingEnd="13dp"
    android:paddingBottom="11dp">

    <!-- Top Bar: Quick Add (Left), Percent Pill, Spacer, Headline & Date & Brand (Right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Quick Add Action Button (Left) -->
        <ImageButton
            android:id="@+id/widget_large_add_btn"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/widget_btn_bg_b"
            android:contentDescription="افزودن کار"
            android:src="@drawable/ic_widget_plus"
            android:tint="@color/ted_b_button_text"
            android:padding="6.5dp" />

        <!-- Percentage Badge (Pill) -->
        <FrameLayout
            android:id="@+id/widget_large_percent_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_pill_bg"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/widget_large_percent_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="Percent" />
        </FrameLayout>

        <!-- Spacer -->
        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Headline & Subtitle & Brand Icon (Right) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_large_headline_img"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="Headline" />

                <ImageView
                    android:id="@+id/widget_large_sub_img"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1.5dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Subtitle" />
            </LinearLayout>

            <!-- Brand Icon Card -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/widget_task_bg_b"
                android:contentDescription="Tedlist"
                android:src="@drawable/ic_widget_check_brand"
                android:padding="3dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 10-Segment Progress Track -->
    <LinearLayout
        android:id="@+id/widget_large_segmented_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_seg_1"
            android:layout_width="0dp"
            android:layout_height="3.5dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:src="@drawable/widget_segment_inactive" />

        <ImageView
            android:id="@+id/widget_seg_2"
            android:layout_width="0dp"
            android:layout_height="3.5dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:src="@drawable/widget_segment_inactive" />

        <ImageView
            android:id="@+id/widget_seg_3"
            android:layout_width="0dp"
            android:layout_height="3.5dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:src="@drawable/widget_segment_inactive" />

        <ImageView
            android:id="@+id/widget_seg_4"
            android:layout_width="0dp"
            android:layout_height="3.5dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:src="@drawable/widget_segment_inactive" />

        <ImageView
            android:id="@+id/widget_seg_5"
            android:layout_width="0dp"
            android:layout_height="3.5dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:src="@drawable/widget_segment_inactive" />

        <ImageView
            android:id="@+id/widget_seg_6"
            android:layout_width="0dp"
            android:layout_height="3.5dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:src="@drawable/widget_segment_active" />

        <ImageView
            android:id="@+id/widget_seg_7"
            android:layout_width="0dp"
            android:layout_height="3.5dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:src="@drawable/widget_segment_active" />

        <ImageView
            android:id="@+id/widget_seg_8"
            android:layout_width="0dp"
            android:layout_height="3.5dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:src="@drawable/widget_segment_active" />

        <ImageView
            android:id="@+id/widget_seg_9"
            android:layout_width="0dp"
            android:layout_height="3.5dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:src="@drawable/widget_segment_active" />

        <ImageView
            android:id="@+id/widget_seg_10"
            android:layout_width="0dp"
            android:layout_height="3.5dp"
            android:layout_weight="1"
            android:src="@drawable/widget_segment_active" />
    </LinearLayout>

    <!-- Tasks List Container -->
    <LinearLayout
        android:id="@+id/widget_large_tasks_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Task 1 -->
        <LinearLayout
            android:id="@+id/widget_task_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_task_bg_b"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="6.5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6.5dp"
            android:layout_marginBottom="4dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/widget_task_radio_ring" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_task_1_title_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="Task 1" />

            <ImageView
                android:id="@+id/widget_task_1_dot"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/widget_dot_amber" />
        </LinearLayout>

        <!-- Task 2 -->
        <LinearLayout
            android:id="@+id/widget_task_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_task_bg_b"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="6.5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6.5dp"
            android:layout_marginBottom="4dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/widget_task_radio_ring" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_task_2_title_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="Task 2" />

            <ImageView
                android:id="@+id/widget_task_2_dot"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/widget_dot_amber" />
        </LinearLayout>

        <!-- Task 3 -->
        <LinearLayout
            android:id="@+id/widget_task_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_task_bg_b"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="6.5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6.5dp"
            android:layout_marginBottom="4dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/widget_task_radio_ring" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_task_3_title_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="Task 3" />

            <ImageView
                android:id="@+id/widget_task_3_dot"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/widget_dot_amber" />
        </LinearLayout>

        <!-- Add Next Task Action (Shown when fewer than 3 tasks) -->
        <LinearLayout
            android:id="@+id/widget_task_add_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_task_placeholder_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:tint="@color/ted_b_muted"
                android:src="@drawable/ic_widget_plus" />

            <ImageView
                android:id="@+id/widget_task_add_next_title_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:adjustViewBounds="true"
                android:contentDescription="Add Next" />
        </LinearLayout>
    </LinearLayout>

    <!-- Rich Empty / Done State Card -->
    <LinearLayout
        android:id="@+id/widget_large_empty_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_empty_state_card_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_large_empty_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginBottom="5dp"
            android:src="@drawable/ic_widget_check_circle" />

        <ImageView
            android:id="@+id/widget_large_empty_title_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="Empty Title" />

        <ImageView
            android:id="@+id/widget_large_empty_sub_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2.5dp"
            android:adjustViewBounds="true"
            android:contentDescription="Empty Subtitle" />
    </LinearLayout>
</LinearLayout>
