<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_large_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_a"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Bar: Brand, Status, and Action -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Tedlist"
            android:src="@drawable/ic_tedlist_mark"
            android:background="@drawable/widget_task_bg_a"
            android:padding="4dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_large_headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="امروز رو جمع‌وجور کنیم"
                android:textColor="@color/ted_a_text"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/widget_large_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="۲ کار باقی‌مانده برای امروز"
                android:textColor="@color/ted_a_secondary"
                android:textSize="9.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_large_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="30dp"
            android:gravity="center"
            android:fontFamily="monospace"
            android:text="60%"
            android:textColor="@color/ted_a_accent"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/widget_large_add_btn"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_btn_bg_a"
            android:contentDescription="افزودن کار"
            android:src="@drawable/ic_widget_plus"
            android:tint="@color/ted_a_button_text"
            android:padding="6dp" />
    </LinearLayout>

    <!-- Progress Track & Percentage -->
    <ProgressBar
        android:id="@+id/widget_large_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="60"
        android:progressDrawable="@drawable/widget_progress_bar_a" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="@color/ted_a_border" />

    <!-- Tasks List Container -->
    <LinearLayout
        android:id="@+id/widget_large_tasks_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Task 1 -->
        <LinearLayout
            android:id="@+id/widget_task_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_task_bg_a"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp"
            android:layout_marginBottom="4dp">

            <View
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:background="#E68A97" />

            <TextView
                android:id="@+id/widget_task_1_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="کار اول"
                android:textColor="@color/ted_a_text"
                android:textSize="10.5sp" />

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/widget_check_a" />
        </LinearLayout>

        <!-- Task 2 -->
        <LinearLayout
            android:id="@+id/widget_task_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_task_bg_a"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp"
            android:layout_marginBottom="4dp">

            <View
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:background="#E5BC78" />

            <TextView
                android:id="@+id/widget_task_2_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="کار دوم"
                android:textColor="@color/ted_a_text"
                android:textSize="10.5sp" />

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/widget_check_a" />
        </LinearLayout>

        <!-- Task 3 -->
        <LinearLayout
            android:id="@+id/widget_task_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_task_bg_a"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp">

            <View
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:background="#758196" />

            <TextView
                android:id="@+id/widget_task_3_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="کار سوم"
                android:textColor="@color/ted_a_text"
                android:textSize="10.5sp" />

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/widget_check_a" />
        </LinearLayout>
    </LinearLayout>

    <!-- Empty State (Shown when 0 tasks) -->
    <TextView
        android:id="@+id/widget_large_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="همه کارهای امروز تمام شد! ✨"
        android:textColor="@color/ted_a_secondary"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone" />
</LinearLayout>
