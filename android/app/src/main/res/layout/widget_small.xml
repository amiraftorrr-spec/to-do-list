<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_small_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_b"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="7dp"
    android:paddingEnd="12dp"
    android:paddingBottom="7dp">

    <!-- Top Row: Percent Pill (Left), Spacer, Brand Title & Icon (Right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/widget_small_percent_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_bg"
            android:paddingStart="6dp"
            android:paddingTop="1.5dp"
            android:paddingEnd="6dp"
            android:paddingBottom="1.5dp">

            <ImageView
                android:id="@+id/widget_small_percent_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="Percent" />
        </FrameLayout>

        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/widget_small_title_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="Title" />

        <ImageView
            android:id="@+id/widget_small_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_task_bg_b"
            android:contentDescription="Tedlist"
            android:padding="2.5dp"
            android:src="@drawable/ic_widget_check_brand" />
    </LinearLayout>

    <!-- Middle Row: Headline & Subtitle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="end"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_small_headline_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="Headline" />

        <ImageView
            android:id="@+id/widget_small_sub_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:adjustViewBounds="true"
            android:contentDescription="Subtitle" />
    </LinearLayout>

    <!-- Bottom Row: Sleek Progress Bar -->
    <ProgressBar
        android:id="@+id/widget_small_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3.5dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progress="60"
        android:progressDrawable="@drawable/widget_progress_bar_b" />
</LinearLayout>
