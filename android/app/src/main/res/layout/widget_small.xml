<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_small_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_b"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <!-- Brand Icon Mark -->
    <ImageView
        android:id="@+id/widget_small_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="Tedlist"
        android:src="@drawable/ic_widget_check_brand"
        android:background="@drawable/widget_task_bg_b"
        android:padding="3.5dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_small_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:text="روزت رو مرتب کن"
            android:textColor="@color/ted_b_text"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_small_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:text="۲ کار باقی‌مانده"
            android:textColor="@color/ted_b_secondary"
            android:textSize="9.5sp" />

        <ProgressBar
            android:id="@+id/widget_small_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progress="60"
            android:progressDrawable="@drawable/widget_progress_bar_b" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_small_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="30dp"
        android:gravity="center"
        android:fontFamily="monospace"
        android:text="60%"
        android:textColor="@color/ted_b_accent"
        android:textSize="10.5sp"
        android:textStyle="bold" />
</LinearLayout>
