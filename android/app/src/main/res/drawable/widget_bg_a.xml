<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ted_a_bg" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/ted_a_border" />
        </shape>
    </item>
    <item android:top="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="17dp" />
            <stroke android:width="1dp" android:color="@color/ted_a_rim" />
        </shape>
    </item>
</layer-list>
